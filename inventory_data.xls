<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Worksheet ss:Name="Products">
  <Table>
   <Row>
    <Cell><Data ss:Type="String">SKU</Data></Cell>
    <Cell><Data ss:Type="String">Name</Data></Cell>
    <Cell><Data ss:Type="String">Price</Data></Cell>
    <Cell><Data ss:Type="String">Stock Quantity</Data></Cell>
    <Cell><Data ss:Type="String">Description</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">HEAD-WIRE-001</Data></Cell>
    <Cell><Data ss:Type="String">Wireless Headphones</Data></Cell>
    <Cell><Data ss:Type="Number">199.99</Data></Cell>
    <Cell><Data ss:Type="Number">50</Data></Cell>
    <Cell><Data ss:Type="String">Noise-cancelling over-ear wireless headphones</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">WATCH-SMART-002</Data></Cell>
    <Cell><Data ss:Type="String">Smart Watch</Data></Cell>
    <Cell><Data ss:Type="Number">249.99</Data></Cell>
    <Cell><Data ss:Type="Number">30</Data></Cell>
    <Cell><Data ss:Type="String">Fitness tracking smartwatch with heart rate monitor</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">KEY-MECH-003</Data></Cell>
    <Cell><Data ss:Type="String">Mechanical Keyboard</Data></Cell>
    <Cell><Data ss:Type="Number">89.99</Data></Cell>
    <Cell><Data ss:Type="Number">100</Data></Cell>
    <Cell><Data ss:Type="String">RGB tactile mechanical keyboard with blue switches</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">HUB-USBC-004</Data></Cell>
    <Cell><Data ss:Type="String">USB-C Hub</Data></Cell>
    <Cell><Data ss:Type="Number">45.5</Data></Cell>
    <Cell><Data ss:Type="Number">75</Data></Cell>
    <Cell><Data ss:Type="String">8-in-1 USB-C adapter with HDMI and ethernet</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">CHAIR-OFF-005</Data></Cell>
    <Cell><Data ss:Type="String">Ergonomic Office Chair</Data></Cell>
    <Cell><Data ss:Type="Number">320.0</Data></Cell>
    <Cell><Data ss:Type="Number">15</Data></Cell>
    <Cell><Data ss:Type="String">High-back mesh office chair with lumbar support</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="Customers">
  <Table>
   <Row>
    <Cell><Data ss:Type="String">Name</Data></Cell>
    <Cell><Data ss:Type="String">Email</Data></Cell>
    <Cell><Data ss:Type="String">Phone</Data></Cell>
    <Cell><Data ss:Type="String">Address</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Alice Smith</Data></Cell>
    <Cell><Data ss:Type="String">alice@example.com</Data></Cell>
    <Cell><Data ss:Type="String">123-456-7890</Data></Cell>
    <Cell><Data ss:Type="String">123 Main St, New York</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Bob Jones</Data></Cell>
    <Cell><Data ss:Type="String">bob@example.com</Data></Cell>
    <Cell><Data ss:Type="String">987-654-3210</Data></Cell>
    <Cell><Data ss:Type="String">456 Oak Rd, San Francisco</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Charlie Brown</Data></Cell>
    <Cell><Data ss:Type="String">charlie@example.com</Data></Cell>
    <Cell><Data ss:Type="String">555-555-5555</Data></Cell>
    <Cell><Data ss:Type="String">789 Pine Ave, Seattle</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="Orders">
  <Table>
   <Row>
    <Cell><Data ss:Type="String">Customer Email</Data></Cell>
    <Cell><Data ss:Type="String">Status</Data></Cell>
    <Cell><Data ss:Type="String">Total Amount</Data></Cell>
    <Cell><Data ss:Type="String">Items (SKU:Quantity)</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">alice@example.com</Data></Cell>
    <Cell><Data ss:Type="String">completed</Data></Cell>
    <Cell><Data ss:Type="Number">289.98</Data></Cell>
    <Cell><Data ss:Type="String">HEAD-WIRE-001:1, KEY-MECH-003:1</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">bob@example.com</Data></Cell>
    <Cell><Data ss:Type="String">pending</Data></Cell>
    <Cell><Data ss:Type="Number">340.99</Data></Cell>
    <Cell><Data ss:Type="String">WATCH-SMART-002:1, HUB-USBC-004:2</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
</Workbook>
